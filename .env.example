# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. NEVER commit .env.
# Every value in THIS file must remain a placeholder.
# ---------------------------------------------------------------------------

# Primary LLM provider: gemini | openai | anthropic
LLM_PROVIDER=gemini

# Google Gemini (primary recommendation)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash-lite

# OpenAI (first fallback)
OPENAI_API_KEY=your-openai-api-key-here
FALLBACK_PROVIDER=openai
FALLBACK_MODEL=gpt-5-mini

# Anthropic (second fallback)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-haiku-4-5

# Fetching and content limits
REQUEST_TIMEOUT_SECONDS=10
LLM_TIMEOUT_SECONDS=45
MAX_FETCH_BYTES=5000000
MAX_CONTENT_TOKENS=15000
MAX_URL_LENGTH=2048
MAX_REDIRECTS=5

# LLM generation
TEMPERATURE=0.2
MAX_OUTPUT_TOKENS=4000
MAX_RETRIES=1

# Caching
CACHE_TTL_SECONDS=3600

# Logging
LOG_LEVEL=INFO
